---
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Approach from "../components/Approach.astro";
import Services from "../components/Services.astro";
import Impact from "../components/Impact.astro";
import Journey from "../components/Journey.astro";
import Credentials from "../components/Credentials.astro";
import Contact from "../components/Contact.astro";
import { siteConfig } from "../config";
import "../styles/global.css";

const c = siteConfig.colors;
const cssVars = `--color-primary-dark:${c.primaryDark};--color-primary:${c.primary};--color-primary-light:${c.primaryLight};--color-accent:${c.accent};--color-surface:${c.surface};--color-surface-light:${c.surfaceLight};--color-sage:${c.sage}`;
---

<html lang="en" style={cssVars}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={siteConfig.description.en} />
    <meta property="og:title" content={`${siteConfig.name} — ${siteConfig.title.en}`} />
    <meta property="og:description" content={siteConfig.description.en} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Work+Sans:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{siteConfig.name} — {siteConfig.title.en}</title>
  </head>
  <body class="bg-[var(--color-surface-light)] text-[var(--color-primary)]">
    <Nav />
    <main>
      <Hero />
      <Approach />
      <Services />
      <Impact />
      <Journey />
      <Credentials />
      <Contact />
    </main>

    <!-- Scroll Reveal Animation -->
    <script>
      const observerOptions = {
        root: null,
        rootMargin: '0px 0px -10% 0px',
        threshold: 0.1
      };

      const revealOnScroll = (entries: IntersectionObserverEntry[], observer: IntersectionObserver) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            observer.unobserve(entry.target);
          }
        });
      };

      const observer = new IntersectionObserver(revealOnScroll, observerOptions);

      document.querySelectorAll('.reveal, .reveal-left, .reveal-right, .reveal-scale').forEach(el => {
        observer.observe(el);
      });
    </script>
  </body>
</html>
