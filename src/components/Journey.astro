---
import { siteConfig } from "../config";
const { journey } = siteConfig;
---

<section id="journey" class="py-20 md:py-28 bg-[var(--color-surface)]">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="reveal font-heading text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] text-center" data-en="The Journey" data-es="Trayectoria">
      The Journey
    </h2>
    <div class="w-16 h-1 bg-[var(--color-accent)] mx-auto mt-4 rounded-full"></div>

    <!-- Desktop: Horizontal 3-col -->
    <div class="mt-14 hidden md:grid md:grid-cols-3 gap-8 relative">
      <!-- Connecting line -->
      <div class="absolute top-12 left-[16%] right-[16%] h-px bg-[var(--color-primary-light)]/20"></div>
      <div class="absolute top-12 left-[16%] right-[16%] h-px bg-[var(--color-accent)]/30 origin-left scale-x-0 transition-transform duration-1000 journey-line"></div>

      {journey.map((phase, i) => (
        <div class={`reveal stagger-${i + 1} relative text-center`}>
          <!-- Flag circle -->
          <div class="w-24 h-24 mx-auto rounded-full bg-white shadow-md flex items-center justify-center text-4xl relative z-10 border-2 border-[var(--color-surface)]">
            {phase.flag}
          </div>

          <div class="mt-6">
            <h3 class="font-heading text-xl font-bold text-[var(--color-primary-dark)]" data-en={phase.phase.en} data-es={phase.phase.es}>
              {phase.phase.en}
            </h3>
            <p class="mt-1 text-sm font-body text-[var(--color-accent)] font-semibold" data-en={phase.location.en} data-es={phase.location.es}>
              {phase.location.en}
            </p>
            <p class="text-xs font-body text-[var(--color-primary-light)] mt-1">{phase.period}</p>
          </div>

          <ul class="mt-5 space-y-2 text-left">
            {phase.highlights.map(h => (
              <li class="flex items-start gap-2 text-sm font-body text-[var(--color-primary)]">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-sage)] mt-1.5 flex-shrink-0"></span>
                <span data-en={h.en} data-es={h.es}>{h.en}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Mobile: Vertical timeline -->
    <div class="mt-14 md:hidden space-y-10 relative">
      <div class="absolute left-6 top-0 bottom-0 w-px bg-[var(--color-primary-light)]/20"></div>

      {journey.map((phase, i) => (
        <div class={`reveal stagger-${i + 1} relative pl-16`}>
          <!-- Flag circle -->
          <div class="absolute left-0 top-0 w-12 h-12 rounded-full bg-white shadow-md flex items-center justify-center text-xl border-2 border-[var(--color-surface)] z-10">
            {phase.flag}
          </div>

          <h3 class="font-heading text-lg font-bold text-[var(--color-primary-dark)]" data-en={phase.phase.en} data-es={phase.phase.es}>
            {phase.phase.en}
          </h3>
          <p class="text-sm font-body text-[var(--color-accent)] font-semibold" data-en={phase.location.en} data-es={phase.location.es}>
            {phase.location.en}
          </p>
          <p class="text-xs font-body text-[var(--color-primary-light)]">{phase.period}</p>

          <ul class="mt-3 space-y-2">
            {phase.highlights.map(h => (
              <li class="flex items-start gap-2 text-sm font-body text-[var(--color-primary)]">
                <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-sage)] mt-1.5 flex-shrink-0"></span>
                <span data-en={h.en} data-es={h.es}>{h.en}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  // Animate the connecting line on desktop
  const lineObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const line = entry.target.querySelector('.journey-line');
        if (line) (line as HTMLElement).style.transform = 'scaleX(1)';
        lineObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });

  const journeySection = document.getElementById('journey');
  if (journeySection) lineObserver.observe(journeySection);
</script>
