---
import { siteConfig } from "../config";
const { journey } = siteConfig;
---

<section id="journey" class="py-24 md:py-32 bg-[var(--color-surface)]">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-6">
      <span class="reveal text-xs font-body font-semibold tracking-[0.2em] uppercase text-[var(--color-sage)]" data-en="Background" data-es="Trayectoria">Background</span>
    </div>
    <h2 class="reveal font-accent text-4xl md:text-5xl font-semibold text-[var(--color-primary-dark)] text-center leading-tight" data-en="The Journey" data-es="La Trayectoria">
      The Journey
    </h2>
    <div class="flex items-center justify-center gap-2 mt-5 mb-16">
      <div class="w-12 h-1 rounded-full bg-[var(--color-accent)]"></div>
      <div class="w-3 h-3 rounded-full bg-[var(--color-accent)] opacity-40"></div>
      <div class="w-12 h-1 rounded-full bg-[var(--color-accent)]"></div>
    </div>

    <!-- Desktop: Horizontal 3-col with connecting arrows -->
    <div class="hidden md:block">
      <div class="grid grid-cols-3 gap-8 relative">
        <!-- Connecting arrows -->
        <div class="absolute top-16 left-[30%] w-[12%] flex items-center justify-center z-10 journey-arrow">
          <div class="w-full h-px bg-[var(--color-accent)]/40"></div>
          <svg class="absolute right-0 w-4 h-4 text-[var(--color-accent)]/60" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5l8 7-8 7z"/></svg>
        </div>
        <div class="absolute top-16 left-[63%] w-[12%] flex items-center justify-center z-10 journey-arrow">
          <div class="w-full h-px bg-[var(--color-accent)]/40"></div>
          <svg class="absolute right-0 w-4 h-4 text-[var(--color-accent)]/60" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5l8 7-8 7z"/></svg>
        </div>

        {journey.map((phase, i) => (
          <div class={`reveal stagger-${i + 1}`}>
            <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-all duration-500 border border-[var(--color-sage)]/10 h-full relative group">
              <!-- Flag -->
              <div class="w-20 h-20 mx-auto rounded-full bg-[var(--color-surface)] shadow-md flex items-center justify-center text-4xl mb-6 group-hover:scale-110 transition-transform duration-300 border-2 border-white">
                {phase.flag}
              </div>

              <div class="text-center mb-6">
                <h3 class="font-accent text-2xl font-semibold text-[var(--color-primary-dark)]" data-en={phase.phase.en} data-es={phase.phase.es}>
                  {phase.phase.en}
                </h3>
                <p class="text-sm font-body font-semibold text-[var(--color-accent)] mt-1" data-en={phase.location.en} data-es={phase.location.es}>
                  {phase.location.en}
                </p>
                <p class="text-xs font-body text-[var(--color-primary-light)] mt-1 tracking-wider">{phase.period}</p>
              </div>

              <div class="w-8 h-0.5 rounded-full bg-[var(--color-sage)] mx-auto mb-5"></div>

              <ul class="space-y-3">
                {phase.highlights.map(h => (
                  <li class="flex items-start gap-3 text-sm font-body text-[var(--color-primary)] leading-relaxed">
                    <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-sage)] mt-2 flex-shrink-0"></span>
                    <span data-en={h.en} data-es={h.es}>{h.en}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Mobile: Vertical timeline -->
    <div class="md:hidden space-y-8 relative">
      <div class="absolute left-7 top-0 bottom-0 w-px bg-gradient-to-b from-[var(--color-sage)]/30 via-[var(--color-accent)]/30 to-[var(--color-sage)]/30"></div>

      {journey.map((phase, i) => (
        <div class={`reveal stagger-${i + 1} relative pl-20`}>
          <!-- Flag circle -->
          <div class="absolute left-0 top-0 w-14 h-14 rounded-full bg-white shadow-lg flex items-center justify-center text-2xl border-2 border-[var(--color-surface)] z-10">
            {phase.flag}
          </div>

          <div class="bg-white rounded-2xl p-6 shadow-sm border border-[var(--color-sage)]/10">
            <h3 class="font-accent text-xl font-semibold text-[var(--color-primary-dark)]" data-en={phase.phase.en} data-es={phase.phase.es}>
              {phase.phase.en}
            </h3>
            <p class="text-sm font-body font-semibold text-[var(--color-accent)] mt-0.5" data-en={phase.location.en} data-es={phase.location.es}>
              {phase.location.en}
            </p>
            <p class="text-xs font-body text-[var(--color-primary-light)] tracking-wider">{phase.period}</p>

            <div class="w-6 h-0.5 rounded-full bg-[var(--color-sage)] mt-3 mb-3"></div>

            <ul class="space-y-2">
              {phase.highlights.map(h => (
                <li class="flex items-start gap-2 text-sm font-body text-[var(--color-primary)]">
                  <span class="w-1.5 h-1.5 rounded-full bg-[var(--color-sage)] mt-1.5 flex-shrink-0"></span>
                  <span data-en={h.en} data-es={h.es}>{h.en}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
