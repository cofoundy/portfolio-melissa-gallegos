---
import { siteConfig } from "../config";
const { approach } = siteConfig;
const pillars = approach.pillars;

const icons: Record<string, string> = {
  eye: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/></svg>`,
  shield: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>`,
  compass: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>`,
  heart: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>`,
};
---

<section id="approach" class="py-20 md:py-28 bg-[var(--color-surface)]">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="reveal font-heading text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] text-center" data-en="My Approach" data-es="Mi Enfoque">
      My Approach
    </h2>
    <div class="w-16 h-1 bg-[var(--color-accent)] mx-auto mt-4 rounded-full"></div>

    <p class="reveal stagger-1 mt-8 text-center text-[var(--color-primary)] font-body text-base md:text-lg max-w-2xl mx-auto leading-relaxed" data-en={approach.intro.en} data-es={approach.intro.es}>
      {approach.intro.en}
    </p>

    <!-- Pillars Grid -->
    <div class="mt-16 grid grid-cols-1 sm:grid-cols-2 gap-8 md:gap-10 max-w-3xl mx-auto">
      {pillars.map((pillar, i) => (
        <div class={`reveal-scale stagger-${i + 1} group relative bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-shadow duration-300 border border-[var(--color-sage)]/20`}>
          <!-- Icon -->
          <div class="w-14 h-14 rounded-xl bg-[var(--color-sage)]/15 flex items-center justify-center text-[var(--color-sage)] mb-5 group-hover:bg-[var(--color-sage)]/25 transition-colors">
            <Fragment set:html={icons[pillar.icon]} />
          </div>

          <!-- Title -->
          <h3 class="font-heading text-xl font-bold text-[var(--color-primary-dark)]" data-en={pillar.title.en} data-es={pillar.title.es}>
            {pillar.title.en}
          </h3>

          <!-- Description -->
          <p class="mt-3 text-sm text-[var(--color-primary-light)] font-body leading-relaxed" data-en={pillar.description.en} data-es={pillar.description.es}>
            {pillar.description.en}
          </p>

          <!-- Decorative dot -->
          <div class="absolute top-4 right-4 w-2 h-2 rounded-full bg-[var(--color-sage)]/40"></div>
        </div>
      ))}
    </div>

    <!-- Connecting visual (desktop only) -->
    <div class="hidden md:flex justify-center mt-8">
      <svg width="200" height="40" viewBox="0 0 200 40" fill="none" class="pillar-connector">
        <path d="M20 20 H180" stroke="var(--color-sage)" stroke-width="1" stroke-dasharray="4 4" opacity="0.4"/>
        <circle cx="20" cy="20" r="4" fill="var(--color-sage)" opacity="0.3"/>
        <circle cx="100" cy="20" r="4" fill="var(--color-accent)" opacity="0.5"/>
        <circle cx="180" cy="20" r="4" fill="var(--color-sage)" opacity="0.3"/>
      </svg>
    </div>
  </div>
</section>
