---
import { siteConfig } from "../config";
const { cta, social, name, colors } = siteConfig;
---

<!-- Shimmer divider -->
<div class="w-full h-1 bar-shimmer"></div>

<section id="contact" class="py-24 md:py-32 relative overflow-hidden" style={`background: linear-gradient(160deg, ${colors.primaryDark} 0%, ${colors.primary} 60%, ${colors.primaryDark} 100%)`}>
  <!-- Decorative -->
  <div class="absolute top-10 left-10 w-64 h-64 rounded-full opacity-[0.04] blur-3xl" style={`background: ${colors.accent}`}></div>
  <div class="absolute bottom-10 right-10 w-48 h-48 rounded-full opacity-[0.03] blur-3xl" style={`background: ${colors.sage}`}></div>
  <!-- Decorative dots -->
  <div class="absolute top-1/4 right-1/4 w-2 h-2 rounded-full bg-[var(--color-accent)] opacity-15"></div>
  <div class="absolute bottom-1/3 left-1/3 w-1.5 h-1.5 rounded-full bg-white opacity-10"></div>

  <div class="max-w-3xl mx-auto px-6 text-center relative z-10">
    <!-- Decorative quote marks -->
    <div class="reveal mb-8 opacity-20">
      <span class="font-accent text-8xl text-[var(--color-accent)] leading-none">"</span>
    </div>

    <p class="reveal font-accent text-2xl md:text-3xl lg:text-4xl italic text-white/90 leading-relaxed -mt-12" data-en={cta.quote.en} data-es={cta.quote.es}>
      {cta.quote.en}
    </p>

    <!-- Accent separator -->
    <div class="flex items-center justify-center gap-2 mt-8 mb-10">
      <div class="w-8 h-0.5 rounded-full bg-[var(--color-accent)]/50"></div>
      <div class="w-2 h-2 rounded-full bg-[var(--color-accent)]/30"></div>
      <div class="w-8 h-0.5 rounded-full bg-[var(--color-accent)]/50"></div>
    </div>

    <a
      href={`mailto:${social.email}`}
      class="reveal stagger-1 btn-hover group inline-flex items-center gap-3 bg-[var(--color-accent)] text-white font-body font-semibold px-12 py-5 rounded-full shadow-xl hover:shadow-2xl transition-all text-base tracking-wider uppercase"
      data-en={cta.buttonText.en} data-es={cta.buttonText.es}
    >
      <span>{cta.buttonText.en}</span>
      <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>

    <div class="reveal stagger-2 mt-10">
      <a href={`mailto:${social.email}`} class="text-white/60 hover:text-white transition-colors font-body text-sm tracking-wide">
        {social.email}
      </a>
    </div>

    <div class="reveal stagger-3 mt-8 flex items-center justify-center gap-4">
      {social.linkedin && (
        <a href={social.linkedin} target="_blank" rel="noopener" class="icon-hover inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/10 text-white/70 hover:bg-[var(--color-accent)] hover:text-white transition-all duration-300" aria-label="LinkedIn">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h14m-.5 15.5v-5.3a3.26 3.26 0 00-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 011.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 001.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 00-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/></svg>
        </a>
      )}
      <a href={`mailto:${social.email}`} class="icon-hover inline-flex items-center justify-center w-12 h-12 rounded-full bg-white/10 text-white/70 hover:bg-[var(--color-accent)] hover:text-white transition-all duration-300" aria-label="Email">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 01-2.06 0L2 7"/></svg>
      </a>
    </div>
  </div>
</section>

<!-- Footer -->
<footer class="py-8" style={`background-color: ${colors.primaryDark}`}>
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-[var(--color-accent)]/20 flex items-center justify-center">
          <span class="text-xs font-bold text-[var(--color-accent)]">MG</span>
        </div>
        <p class="text-white/30 text-xs font-body">
          &copy; 2026 {name}
        </p>
      </div>
      <p class="text-white/25 text-xs font-body">
        Built with ♡ by <a href="https://cofoundy.com" target="_blank" rel="noopener" class="text-white/40 hover:text-white/60 transition-colors">Cofoundy</a>
      </p>
    </div>
  </div>
</footer>
