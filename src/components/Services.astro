---
import { siteConfig } from "../config";
const { services } = siteConfig;

const icons: Record<string, string> = {
  user: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  users: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`,
  building: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01M16 6h.01M12 6h.01M8 10h.01M16 10h.01M12 10h.01M8 14h.01M16 14h.01M12 14h.01"/></svg>`,
};
---

<section id="services" class="py-24 md:py-32 bg-[var(--color-surface-light)]">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-6">
      <span class="reveal text-xs font-body font-semibold tracking-[0.2em] uppercase text-[var(--color-sage)]" data-en="Services" data-es="Servicios">Services</span>
    </div>
    <h2 class="reveal font-accent text-4xl md:text-5xl font-semibold text-[var(--color-primary-dark)] text-center leading-tight" data-en="What I Offer" data-es="Lo Que Ofrezco">
      What I Offer
    </h2>
    <div class="flex items-center justify-center gap-2 mt-5">
      <div class="w-12 h-1 rounded-full bg-[var(--color-accent)]"></div>
      <div class="w-3 h-3 rounded-full bg-[var(--color-accent)] opacity-40"></div>
      <div class="w-12 h-1 rounded-full bg-[var(--color-accent)]"></div>
    </div>

    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
      {services.map((service, i) => (
        <div class={`reveal-scale stagger-${i + 1} group project-card card-hover bg-white rounded-2xl p-10 shadow-sm border border-gray-100/80 text-center`}>
          <!-- Icon -->
          <div class="w-20 h-20 mx-auto rounded-2xl bg-gradient-to-br from-[var(--color-accent)]/15 to-[var(--color-accent)]/5 flex items-center justify-center text-[var(--color-accent)] mb-8 group-hover:scale-110 transition-transform duration-300">
            <Fragment set:html={icons[service.icon] || icons.user} />
          </div>

          <h3 class="font-accent text-2xl font-semibold text-[var(--color-primary-dark)]" data-en={service.title.en} data-es={service.title.es}>
            {service.title.en}
          </h3>

          <!-- Accent line -->
          <div class="w-8 h-0.5 rounded-full bg-[var(--color-accent)] mx-auto mt-3 mb-5 group-hover:w-16 transition-all duration-500"></div>

          <p class="text-sm text-[var(--color-primary-light)] font-body leading-relaxed" data-en={service.description.en} data-es={service.description.es}>
            {service.description.en}
          </p>

          <a href="#contact" class="inline-flex items-center gap-2 mt-8 text-sm font-semibold text-[var(--color-accent)] hover:opacity-70 transition-opacity group/link" data-en="Learn More" data-es="Saber Más">
            <span>Learn More</span>
            <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
