---
import { siteConfig } from "../config";
const { services } = siteConfig;

const icons: Record<string, string> = {
  user: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>`,
  users: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>`,
  building: `<svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M9 22v-4h6v4"/><path d="M8 6h.01M16 6h.01M12 6h.01M8 10h.01M16 10h.01M12 10h.01M8 14h.01M16 14h.01M12 14h.01"/></svg>`,
};
---

<section id="services" class="py-20 md:py-28 bg-[var(--color-surface-light)]">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="reveal font-heading text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] text-center" data-en="What I Offer" data-es="Servicios">
      What I Offer
    </h2>
    <div class="w-16 h-1 bg-[var(--color-accent)] mx-auto mt-4 rounded-full"></div>

    <div class="mt-14 grid grid-cols-1 md:grid-cols-3 gap-8">
      {services.map((service, i) => (
        <div class={`reveal-scale stagger-${i + 1} card-hover bg-white rounded-2xl p-8 shadow-sm border border-gray-100 text-center`}>
          <div class="w-16 h-16 mx-auto rounded-xl bg-[var(--color-accent)]/10 flex items-center justify-center text-[var(--color-accent)] mb-6">
            <Fragment set:html={icons[service.icon] || icons.user} />
          </div>
          <h3 class="font-heading text-xl font-bold text-[var(--color-primary-dark)]" data-en={service.title.en} data-es={service.title.es}>
            {service.title.en}
          </h3>
          <p class="mt-4 text-sm text-[var(--color-primary-light)] font-body leading-relaxed" data-en={service.description.en} data-es={service.description.es}>
            {service.description.en}
          </p>
          <a href="#contact" class="inline-block mt-6 text-sm font-semibold text-[var(--color-accent)] hover:opacity-70 transition-opacity link-underline" data-en="Learn More →" data-es="Saber Más →">
            Learn More →
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
