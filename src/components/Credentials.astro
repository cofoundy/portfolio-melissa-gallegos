---
import { siteConfig } from "../config";
const { credentials } = siteConfig;
---

<section id="credentials" class="py-20 md:py-28 bg-[var(--color-surface-light)]">
  <div class="max-w-5xl mx-auto px-6">
    <h2 class="reveal font-heading text-3xl md:text-4xl font-bold text-[var(--color-primary-dark)] text-center" data-en="Credentials" data-es="Credenciales">
      Credentials
    </h2>
    <div class="w-16 h-1 bg-[var(--color-accent)] mx-auto mt-4 rounded-full"></div>

    <div class="mt-14 grid grid-cols-1 sm:grid-cols-2 gap-6">
      {credentials.map((cred, i) => (
        <div class={`reveal-scale stagger-${(i % 6) + 1} bg-white rounded-xl p-6 shadow-sm border-l-4 border-[var(--color-sage)] hover:shadow-md transition-shadow`}>
          <div class="flex items-start gap-4">
            <!-- Badge icon -->
            <div class="w-10 h-10 rounded-lg bg-[var(--color-sage)]/15 flex items-center justify-center text-[var(--color-sage)] flex-shrink-0 mt-0.5">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="8" r="7"/><path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12"/>
              </svg>
            </div>

            <div class="flex-1 min-w-0">
              <h3 class="font-heading text-base font-bold text-[var(--color-primary-dark)] leading-snug" data-en={cred.title.en} data-es={cred.title.es}>
                {cred.title.en}
              </h3>
              <p class="text-sm font-body text-[var(--color-primary)] mt-1">{cred.institution}</p>
              <div class="flex items-center gap-3 mt-1.5">
                <span class="text-xs font-body text-[var(--color-primary-light)]">{cred.detail}</span>
                {cred.hours && (
                  <span class="text-xs font-semibold text-[var(--color-accent)] bg-[var(--color-accent)]/10 px-2 py-0.5 rounded-full">
                    {cred.hours}
                  </span>
                )}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
