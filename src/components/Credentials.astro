---
import { siteConfig } from "../config";
const { credentials } = siteConfig;
---

<section id="credentials" class="py-24 md:py-32 bg-[var(--color-surface-light)]">
  <div class="max-w-5xl mx-auto px-6">
    <!-- Section header -->
    <div class="text-center mb-6">
      <span class="reveal text-xs font-body font-semibold tracking-[0.2em] uppercase text-[var(--color-sage)]" data-en="Education & Training" data-es="Educación y Formación">Education & Training</span>
    </div>
    <h2 class="reveal font-accent text-4xl md:text-5xl font-semibold text-[var(--color-primary-dark)] text-center leading-tight" data-en="Credentials" data-es="Credenciales">
      Credentials
    </h2>
    <div class="flex items-center justify-center gap-2 mt-5 mb-16">
      <div class="w-12 h-1 rounded-full bg-[var(--color-accent)]"></div>
      <div class="w-3 h-3 rounded-full bg-[var(--color-accent)] opacity-40"></div>
      <div class="w-12 h-1 rounded-full bg-[var(--color-accent)]"></div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
      {credentials.map((cred, i) => (
        <div class={`reveal-scale stagger-${(i % 6) + 1} group`}>
          <div class="bg-white rounded-2xl p-7 shadow-sm hover:shadow-lg transition-all duration-500 border-l-4 border-[var(--color-sage)] h-full relative overflow-hidden">
            <!-- Subtle pattern overlay on hover -->
            <div class="absolute top-0 right-0 w-24 h-24 rounded-bl-full bg-[var(--color-sage)]/5 group-hover:bg-[var(--color-sage)]/10 transition-colors duration-500"></div>

            <div class="flex items-start gap-5 relative z-1">
              <!-- Badge icon -->
              <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-[var(--color-sage)]/20 to-[var(--color-sage)]/5 flex items-center justify-center text-[var(--color-sage)] flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="8" r="7"/><path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12"/>
                </svg>
              </div>

              <div class="flex-1 min-w-0">
                <h3 class="font-accent text-lg font-semibold text-[var(--color-primary-dark)] leading-snug" data-en={cred.title.en} data-es={cred.title.es}>
                  {cred.title.en}
                </h3>
                <p class="text-sm font-body text-[var(--color-primary)] mt-1.5">{cred.institution}</p>
                <div class="flex items-center gap-3 mt-2">
                  <span class="text-xs font-body text-[var(--color-primary-light)]">{cred.detail}</span>
                  {cred.hours && (
                    <span class="text-xs font-bold text-[var(--color-accent)] bg-[var(--color-accent)]/10 px-3 py-1 rounded-full">
                      {cred.hours}
                    </span>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
